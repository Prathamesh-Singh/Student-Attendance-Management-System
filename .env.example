# Copy this file to .env and replace every REPLACE_* value before starting.
# Do not commit .env.

# Backend database connection (MySQL 8)
SAMS_DB_URL=jdbc:mysql://localhost:3306/sams?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
SAMS_DB_USERNAME=sams
SAMS_DB_PASSWORD=REPLACE_WITH_YOUR_LOCAL_DATABASE_PASSWORD

# Optional: HTTP port for the API (default 8080)
SERVER_PORT=8080
